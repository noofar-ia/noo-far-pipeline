# ═══════════════════════════════════════════════════════════
#  Ñoo Far — Variables d'environnement (MODÈLE)
#  Copier en .env et remplir avec les vraies valeurs.
#  NE JAMAIS committer le vrai .env (il est dans .gitignore).
# ═══════════════════════════════════════════════════════════

# ── Hugging Face ──
# Télécharge les modèles (dont les dépôts privés noofar-ia).
# Générer sur : https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Twilio (canal WhatsApp — sandbox, provider actif) ──
# Console : https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886    # numéro sandbox Twilio

# ── Meta WhatsApp Business API (provider=meta, migration future) ──
# Décommenter lors du passage à provider: meta dans config.yaml
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=